APP_NAME="Handicaps golf"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

# Sha complet du commit construit, renvoyé par GET /api/version ; vide en local
APP_COMMIT=

# Code d'accès partagé par le groupe ; obligatoire, sans lui toute requête HTTP répond 500.
# Le changer ferme les sessions de tous les appareils.
APP_PASSCODE=

APP_LOCALE=fr
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=fr_CA

# Fuseau d'affichage ; le stockage reste en UTC (app.timezone)
APP_DISPLAY_TIMEZONE=America/Montreal

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

# Ports publiés sur l'hôte (5432 est souvent déjà pris)
APP_PORT=80
VITE_PORT=5173
FORWARD_DB_PORT=5433

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=pgsql
DB_HOST=pgsql
DB_PORT=5432
DB_DATABASE=laravel
DB_USERNAME=sail
DB_PASSWORD=password

SESSION_DRIVER=database
# Durée de la session en minutes, comptée depuis la dernière requête : 129600 = 90 jours
SESSION_LIFETIME=129600
SESSION_ENCRYPT=true
SESSION_PATH=/
SESSION_DOMAIN=null
# SESSION_SECURE_COOKIE reste absent : le témoin de session est Secure seulement quand APP_ENV=production
# (config/session.php). true ou false force l'une ou l'autre valeur.

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# Mandataires approuvés, adresses ou plages CIDR séparées par des virgules. Vide : aucun.
# Le joker * est ignoré. Le limiteur de /login lit l'IP du client derrière ces mandataires.
TRUSTED_PROXIES=
