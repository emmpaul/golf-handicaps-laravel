# FrankenPHP en mode classique (design D1) : une exécution PHP par requête, sans worker.
# Dokploy (Traefik) termine le TLS et parle HTTP au port 8080.
{
	auto_https off
	admin off
}

:8080 {
	root * /app/public
	encode zstd gzip

	# Les noms des assets compilés portent une empreinte : ils ne changent jamais.
	@build path /build/*
	header @build Cache-Control "public, max-age=31536000, immutable"

	# Fichiers de public/ servis par Caddy ; toute autre adresse va à index.php.
	php_server
}
